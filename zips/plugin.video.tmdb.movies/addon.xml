<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.tmdb.movies"
       name="TMDb Filmes"
       version="1.2.0"
       provider-name="Rick & Gemini">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.python.pluginsource"
             library="addon.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="pt_BR">Navegue por filmes populares e lançamentos do TMDb.</summary>
    <description lang="pt_BR">Este addon exibe listas de filmes populares e próximos lançamentos diretamente da API do The Movie Database (TMDb), com filtros, busca e integração com o Stremio.</description>
    <platform>all</platform>
    <license>MIT</license>
    <assets>
      <icon type="default">icon.png</icon>
    </assets>
  </extension>
</addon>

